<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b1220">
<title>MatchLab | Análisis de fútbol</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#121d30;--panel2:#0e1728;--line:#26364e;--text:#eef4fb;--muted:#9aa9bd;--green:#38d99b;--blue:#82b4ff;--amber:#f5c879;--red:#ff9b9b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#14243a 0,#0b1220 58%);color:var(--text);font:15px system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:1000px;margin:auto;padding:22px 16px 48px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:26px}.brand{display:flex;gap:10px;align-items:center}.logo{width:42px;height:42px;border-radius:13px;background:var(--green);color:#06140d;display:grid;place-items:center;font-weight:950;font-size:18px}.brandname{font-weight:850;letter-spacing:.08em}.subbrand{font-size:11px;color:var(--muted);letter-spacing:.13em}.tag{border:1px solid #3b4d65;border-radius:999px;padding:7px 10px;color:var(--muted);font-size:12px}h1{font-size:clamp(29px,6vw,46px);line-height:1.06;letter-spacing:-.04em;margin:0 0 12px}.intro{max-width:690px;color:var(--muted);line-height:1.6;margin:0 0 23px}.eyebrow{font-size:11px;color:var(--green);letter-spacing:.17em;font-weight:800;margin-bottom:10px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:22px 0}.metric,.panel{background:linear-gradient(145deg,#142137,#101a2b);border:1px solid var(--line);border-radius:17px;padding:16px}.metric span{display:block;color:var(--muted);font-size:12px}.metric strong{display:block;font-size:23px;margin-top:7px}.metric small{color:var(--muted);font-size:11px}.nav{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0 14px}.nav button,.btn{border:1px solid var(--line);background:#111b2c;color:var(--muted);border-radius:10px;padding:11px 14px;font-weight:750;cursor:pointer}.nav button.active,.btn.primary{background:var(--green);color:#07140e;border-color:var(--green)}.panel h2{font-size:19px;margin:0 0 5px}.muted{color:var(--muted);line-height:1.5;font-size:13px}.notice{background:#2b2417;border:1px solid #574629;border-radius:12px;padding:12px;color:#f2d5a0;font-size:12px;line-height:1.5;margin-top:15px}.hide{display:none}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}.teamcard,.result{border:1px solid var(--line);background:var(--panel2);padding:14px;border-radius:13px;min-width:0}.teamcard h3{margin:0 0 12px;font-size:16px}.field{display:block;color:var(--muted);font-size:12px;margin:10px 0 5px}input{width:100%;background:#091321;border:1px solid #344761;border-radius:9px;color:var(--text);font:inherit;padding:11px}input:focus{outline:2px solid var(--green);outline-offset:1px}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:10px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.results{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.result span{display:block;color:var(--muted);font-size:12px}.result strong{display:block;font-size:25px;color:var(--green);margin:6px 0}.result small{color:var(--muted);font-size:11px}.bar{height:7px;background:#26364e;border-radius:99px;overflow:hidden;margin-top:9px}.bar i{display:block;height:100%;background:var(--green);width:0}.foot{font-size:11px;color:var(--muted);margin-top:22px;line-height:1.5}.fixture{padding:13px 0;border-top:1px solid var(--line)}@media(max-width:600px){.metrics{grid-template-columns:1fr 1fr}.metric:last-child{grid-column:span 2}.grid,.results{grid-template-columns:1fr}.tag{font-size:10px}.formrow{grid-template-columns:1fr 1fr}}
</style></head>
<body><main>
<header class="top"><div class="brand"><div class="logo">M</div><div><div class="brandname">MATCHLAB ⚽</div><div class="subbrand">FOOTBALL INTELLIGENCE</div></div></div><div class="tag">MVP · FASE 2</div></header>
<div class="eyebrow">ANÁLISIS · PROBABILIDAD · DATOS</div><h1>Decisiones con datos.<br><span style="color:var(--green)">No con corazonadas.</span></h1><p class="intro">Analiza un partido usando las medias recientes de ambos equipos. Introduce los datos de sus últimos partidos y MatchLab calculará una primera estimación estadística.</p>
<div class="metrics"><div class="metric"><span>Herramienta activa</span><strong>Calculadora</strong><small>Probabilidades de goles</small></div><div class="metric"><span>Coste</span><strong>0 €</strong><small>Sin suscripción</small></div><div class="metric"><span>Fuente de datos</span><strong>Manual</strong><small>Por ahora, introduce tú las medias</small></div></div>
<div class="nav"><button class="active" data-tab="analysis">Analizar partido</button><button data-tab="method">Metodología</button></div>
<section id="analysis" class="panel"><h2>Analizador de partido</h2><p class="muted">Introduce las medias de los últimos 5 partidos relevantes: goles marcados y encajados por el local jugando en casa, y por el visitante jugando fuera.</p>
<div class="grid"><div class="teamcard"><h3>🏠 Equipo local</h3><label class="field" for="home">Nombre del equipo</label><input id="home" value="Equipo local" maxlength="40"><div class="formrow"><div><label class="field" for="hFor">Goles marcados / partido</label><input id="hFor" type="number" min="0" max="10" step="0.1" value="1.6"></div><div><label class="field" for="hAgainst">Goles encajados / partido</label><input id="hAgainst" type="number" min="0" max="10" step="0.1" value="1.0"></div></div></div>
<div class="teamcard"><h3>✈️ Equipo visitante</h3><label class="field" for="away">Nombre del equipo</label><input id="away" value="Equipo visitante" maxlength="40"><div class="formrow"><div><label class="field" for="aFor">Goles marcados / partido</label><input id="aFor" type="number" min="0" max="10" step="0.1" value="1.2"></div><div><label class="field" for="aAgainst">Goles encajados / partido</label><input id="aAgainst" type="number" min="0" max="10" step="0.1" value="1.4"></div></div></div></div>
<div class="actions"><button class="btn primary" id="calculate">Calcular estimación</button><button class="btn" id="reset">Restablecer ejemplo</button></div>
<div id="output" aria-live="polite"><h2 style="margin-top:24px" id="fixtureTitle">Equipo local vs Equipo visitante</h2><p class="muted" id="expected">Goles esperados estimados: local 1,50 · visitante 1,30 · total 2,80</p><div class="results"><div class="result"><span>Más de 1,5 goles</span><strong id="o15">—</strong><div class="bar"><i id="bar15"></i></div><small>Probabilidad estimada</small></div><div class="result"><span>Más de 2,5 goles</span><strong id="o25">—</strong><div class="bar"><i id="bar25"></i></div><small>Probabilidad estimada</small></div><div class="result"><span>Ambos marcan</span><strong id="btts">—</strong><div class="bar"><i id="barBtts"></i></div><small>Probabilidad estimada</small></div></div></div>
<div class="notice"><b>Importante:</b> esto es una estimación matemática basada exclusivamente en las medias que introduzcas. No consulta internet ni descarga estadísticas automáticamente. Si introduces datos inventados, el resultado también será ficticio. No garantiza resultados.</div></section>
<section id="method" class="panel hide"><h2>Cómo calcula MatchLab</h2><div class="fixture"><b>1. Introduce medias recientes</b><p class="muted">Usa datos de la misma competición y separa localía: partidos del equipo local en casa y del visitante fuera.</p></div><div class="fixture"><b>2. Estima los goles esperados</b><p class="muted">Combina los goles que un equipo suele marcar con los que el rival suele encajar.</p></div><div class="fixture"><b>3. Calcula probabilidades</b><p class="muted">Aplica una aproximación de Poisson a los goles esperados para estimar más de 1,5, más de 2,5 y ambos marcan.</p></div><div class="notice">Es un modelo inicial simplificado, no validado todavía contra resultados históricos. No debe interpretarse como consejo de apuesta.</div></section>
<p class="foot">MATCHLAB · Fase 2. Próxima mejora: conectar una fuente de resultados verificable y automatizar la carga de estadísticas. Las estimaciones no garantizan resultados. Apuesta solo de forma responsable y conforme a la ley.</p>
</main><script>
const tabs=[...document.querySelectorAll('[data-tab]')];tabs.forEach(b=>b.addEventListener('click',()=>{tabs.forEach(x=>x.classList.toggle('active',x===b));['analysis','method'].forEach(id=>document.getElementById(id).classList.toggle('hide',id!==b.dataset.tab))}));
const $=id=>document.getElementById(id);function num(id){const v=Number($(id).value);if(!Number.isFinite(v)||v<0||v>10)throw new Error('Introduce medias entre 0 y 10.');return v}function poisson(k,lambda){return Math.exp(-lambda)*Math.pow(lambda,k)/factorial(k)}function factorial(n){let r=1;for(let i=2;i<=n;i++)r*=i;return r}function pct(v){return Math.round(Math.max(0,Math.min(1,v))*100)+'%'}function setBar(id,v){$(id).style.width=Math.round(Math.max(0,Math.min(1,v))*100)+'%'}
function calculate(){try{const hName=$('home').value.trim()||'Equipo local',aName=$('away').value.trim()||'Equipo visitante';const hF=num('hFor'),hA=num('hAgainst'),aF=num('aFor'),aA=num('aAgainst');const lh=(hF+aA)/2,la=(aF+hA)/2,total=lh+la;let p0=0,p1=0,p2=0,ph0=0,pa0=0;for(let k=0;k<=12;k++){const ph=poisson(k,lh),pa=poisson(k,la);ph0+=k===0?ph:0;pa0+=k===0?pa:0;for(let j=0;j<=12;j++){const p=ph*poisson(j,la);if(k+j<=1)p0+=p;if(k+j<=2)p1+=p;if(k>0&&j>0)p2+=p}}const over15=1-p0,over25=1-p1,btts=1-ph0-pa0+ph0*pa0; $('fixtureTitle').textContent=hName+' vs '+aName;$('expected').textContent='Goles esperados estimados: '+hName+' '+lh.toFixed(2).replace('.',',')+' · '+aName+' '+la.toFixed(2).replace('.',',')+' · total '+total.toFixed(2).replace('.',',');$('o15').textContent=pct(over15);$('o25').textContent=pct(over25);$('btts').textContent=pct(btts);setBar('bar15',over15);setBar('bar25',over25);setBar('barBtts',btts)}catch(e){alert(e.message)}}$('calculate').addEventListener('click',calculate);$('reset').addEventListener('click',()=>{$('home').value='Equipo local';$('away').value='Equipo visitante';$('hFor').value='1.6';$('hAgainst').value='1.0';$('aFor').value='1.2';$('aAgainst').value='1.4';calculate()});calculate();
</script></body></html>
